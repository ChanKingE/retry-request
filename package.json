  "description": "请求库核心实现与配套工具,提供Fetch、Axios、UniApp三种平台适配器,支持请求拦截器、响应拦截器、重试机制等功能。",
  "homepage": "https://github.com/ChanKingE/retry-request#readme",
  "bugs": {
    "url": "https://github.com/ChanKingE/retry-request/issues"
  },
  "license": "MIT",
  "author": "ChanKingE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanKingE/retry-request.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "release": "bumpp",
    "preview:demo": "bun case/demo.ts",
    "preview:test": "bun case/test.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "packageManager": "bun@1.2.19"
}
